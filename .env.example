# Base URL for ALL Civitai API calls (REST /api/v1 + tRPC /api/trpc).
# In-cluster, point this at the internal service, e.g. http://civitai-app:3000
CIVITAI_API_URL=https://civitai.com

# Bearer token for authenticated calls. Optional for browse tools (enhances
# results); required for user-action tools (articles, comments, DMs, etc).
# In HTTP mode this is the fallback when a request omits an Authorization header.
CIVITAI_API_KEY=

# Transport: http (Streamable HTTP, default) or stdio (local dev / MCP clients).
MCP_TRANSPORT=http

# HTTP listen port (http transport only).
PORT=3100

# Optional: skip the user.getToken JWT round-trip for self-id resolution.
CIVITAI_USER_ID=

# --- upload_image safety (SSRF + size guards on user-supplied image URLs) ---
# Max bytes accepted for a fetched/decoded image (default 10485760 = 10 MB).
CIVITAI_UPLOAD_MAX_BYTES=10485760
# Optional CSV allowlist of hostnames permitted for URL-based image uploads.
# When set, ONLY these hosts (and subdomains) may be fetched. Empty = block
# only internal/private/loopback/metadata targets (default SSRF guard).
CIVITAI_UPLOAD_ALLOWED_HOSTS=

# --- MCP HTTP transport hardening ---
# CSV of Host header values allowed by DNS-rebinding protection. When set,
# protection is enabled and only these hosts may reach /mcp. Leave empty
# in-cluster (behind ingress); set for localhost dev if desired, e.g.
# localhost:3100,127.0.0.1:3100
MCP_ALLOWED_HOSTS=
