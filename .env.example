# NOTE: You usually do NOT need to run this yourself. A hosted instance lives at
# https://mcp.civitai.com/mcp — just add that URL to your MCP client and supply
# your Civitai API key via the `Authorization: Bearer <key>` header. See README.
# This file is only for self-hosting.

# Base URL for ALL Civitai API calls (REST /api/v1 + tRPC /api/trpc).
# In-cluster, point this at the internal service, e.g. http://civitai-app:3000
CIVITAI_API_URL=https://civitai.com

# Public website base for user-facing links in tool output (post/model/image/
# profile URLs). Distinct from CIVITAI_API_URL: that may point at an internal
# cluster service, but links handed to users must stay public. The civitai.com
# default is correct for the hosted deployment; only override for civitai.red or
# a self-host on another domain.
CIVITAI_WEB_URL=https://civitai.com

# Bearer token for authenticated calls. Optional for browse tools (enhances
# results); required for user-action tools (articles, comments, DMs, etc).
# In HTTP mode this is the fallback when a request omits an Authorization header.
CIVITAI_API_KEY=

# Transport: http (Streamable HTTP, default) or stdio (local dev / MCP clients).
MCP_TRANSPORT=http

# HTTP listen port (http transport only).
PORT=3100

# Optional: skip the user.getToken JWT round-trip for self-id resolution.
CIVITAI_USER_ID=

# --- upload_image safety (SSRF + size guards on user-supplied image URLs) ---
# Max bytes accepted for a fetched/decoded image (default 10485760 = 10 MB).
CIVITAI_UPLOAD_MAX_BYTES=10485760
# Optional CSV allowlist of hostnames permitted for URL-based image uploads.
# When set, ONLY these hosts (and subdomains) may be fetched. Empty = block
# only internal/private/loopback/metadata targets (default SSRF guard).
CIVITAI_UPLOAD_ALLOWED_HOSTS=

# --- MCP HTTP transport hardening ---
# CSV of Host header values allowed by DNS-rebinding protection. When set,
# protection is enabled and only these hosts may reach /mcp. Leave empty
# in-cluster (behind ingress); set for localhost dev if desired, e.g.
# localhost:3100,127.0.0.1:3100
MCP_ALLOWED_HOSTS=

# Optional canonical public base URL (e.g. https://mcp.civitai.com). When set,
# the advertised MCP endpoint in the landing page / llms.txt uses this instead of
# deriving it from the request Host header. Set this on the canonical hosted
# deployment so it always advertises its public address even behind proxies that
# don't forward Host/X-Forwarded-* reliably. Default: unset (Host-derived).
PUBLIC_BASE_URL=

# --- One-click OAuth (off by default) ---
# Gates the RFC 9728 protected-resource metadata + the 401 WWW-Authenticate
# challenge that makes MCP clients start an OAuth flow. Leave OFF until Civitai's
# OAuth Dynamic Client Registration is live — otherwise a client discovers an auth
# flow that dead-ends at the missing register endpoint. When off, the server runs
# in token-only mode: an unauthenticated call to an auth-required tool returns the
# normal "set CIVITAI_API_KEY" error. Set to true once DCR ships.
OAUTH_ENABLED=false
